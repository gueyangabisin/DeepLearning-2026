import os
import torch
import torch.nn as nn
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# ==============================================================================
# 1. PERSIAPAN DATASET & DATA UJI (X_test, y_test)
# ==============================================================================
url_dataset = "https://raw.githubusercontent.com/gueyangabisin/DeepLearning-2026/main/dataset_harga_rumah.csv"
df = pd.read_csv(url_dataset)

# Konversi harga ke satuan Juta Rupiah agar sesuai skala evaluasi praktikum
if df['harga_rupiah'].max() > 1_000_000:
    df['harga_juta'] = df['harga_rupiah'] / 1_000_000
else:
    df['harga_juta'] = df['harga_rupiah']

X = df[['luas_m2', 'jumlah_kamar', 'jarak_pusat_kota_km']].values
y = df['harga_juta'].values

# Bagi data: 75% (train + validasi) dan 25% data uji (25 data, sesuai kisaran 20-30 data)
X_train_full, X_test_raw, y_train_full, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)
X_train_raw, X_val_raw, y_train_raw, y_val_raw = train_test_split(
    X_train_full, y_train_full, test_size=0.20, random_state=42
)

# Normalisasi fitur dan target menggunakan parameter dari data latih
scaler_X = StandardScaler()
X_train_scaled = scaler_X.fit_transform(X_train_raw)
X_val_scaled = scaler_X.transform(X_val_raw)
X_test_scaled = scaler_X.transform(X_test_raw)

scaler_y = MinMaxScaler()
y_train_scaled = scaler_y.fit_transform(y_train_raw.reshape(-1, 1))
y_val_scaled = scaler_y.transform(y_val_raw.reshape(-1, 1))

# ==============================================================================
# 2. MUAT MODEL HASIL TRAINING P5 (model_harga_rumah.pth)
# ==============================================================================
# Definisi arsitektur model P5 (3 input -> 16 hidden ReLU -> 1 output)
class HargaRumahNet(nn.Module):
    def __init__(self):
        super().__init__()
        self.fc1 = nn.Linear(3, 16)
        self.relu = nn.ReLU()
        self.fc2 = nn.Linear(16, 1)

    def forward(self, x):
        return self.fc2(self.relu(self.fc1(x)))

model_path = "model_harga_rumah.pth"
train_losses, val_losses = [], []

# Jika file model_harga_rumah.pth belum ada di runtime Colab, latih & simpan terlebih dahulu
if not os.path.exists(model_path):
    torch.manual_seed(42)
    model_p5 = nn.Sequential(
        nn.Linear(3, 16),
        nn.ReLU(),
        nn.Linear(16, 1)
    )
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model_p5.parameters(), lr=0.02)

    X_tr_t = torch.tensor(X_train_scaled, dtype=torch.float32)
    y_tr_t = torch.tensor(y_train_scaled, dtype=torch.float32)
    X_va_t = torch.tensor(X_val_scaled, dtype=torch.float32)
    y_va_t = torch.tensor(y_val_scaled, dtype=torch.float32)

    for epoch in range(200):
        model_p5.train()
        pred = model_p5(X_tr_t)
        loss = criterion(pred, y_tr_t)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        train_losses.append(loss.item())

        model_p5.eval()
        with torch.no_grad():
            val_losses.append(criterion(model_p5(X_va_t), y_va_t).item())

    torch.save(model_p5, model_path)

# Muat model dari file .pth
loaded_obj = torch.load(model_path, weights_only=False)
if isinstance(loaded_obj, dict):
    model = HargaRumahNet()
    model.load_state_dict(loaded_obj)
else:
    model = loaded_obj

model.eval()

# ==============================================================================
# 3. PREDIKSI DATA UJI
# ==============================================================================
X_test = torch.tensor(X_test_scaled, dtype=torch.float32)

with torch.no_grad():
    y_pred_scaled = model(X_test).numpy().flatten()
    # Kembalikan hasil prediksi ke satuan Juta Rupiah
    y_pred = scaler_y.inverse_transform(y_pred_scaled.reshape(-1, 1)).flatten()

# ==============================================================================
# 4. HITUNG METRIK EVALUASI (MAE, MSE, RMSE, R²)
# ==============================================================================
mae  = mean_absolute_error(y_test, y_pred)
mse  = mean_squared_error(y_test, y_pred)
rmse = np.sqrt(mse)
r2   = r2_score(y_test, y_pred)

print("=== HASIL EVALUASI MODEL PADA DATA UJI ===")
print(f"MAE  : {mae:.2f}")
print(f"MSE  : {mse:.2f}")
print(f"RMSE : {rmse:.2f}")
print(f"R²   : {r2:.4f}\n")

# Tabel Hasil & Interpretasi
tabel_evaluasi = pd.DataFrame({
    "Metrik": ["MAE", "MSE", "RMSE", "R²"],
    "Hasil": [f"{mae:.2f}", f"{mse:.2f}", f"{rmse:.2f}", f"{r2:.4f}"],
    "Interpretasi": [
        f"Rata-rata kesalahan prediksi {mae:.2f} juta rupiah.",
        f"Rata-rata kuadrat kesalahan {mse:.2f} (juta rupiah)².",
        f"Rata-rata kesalahan (satuan harga) = {rmse:.2f} juta.",
        f"= {r2 * 100:.2f}% variasi harga dapat dijelaskan model."
    ]
})
print("=== TABEL RINGKASAN EVALUASI ===")
print(tabel_evaluasi.to_string(index=False), "\n")

# Tabel Perbandingan Aktual vs Predicted (10 Data Uji Pertama)
tabel_prediksi = pd.DataFrame({
    "Luas (m²)": X_test_raw[:10, 0].astype(int),
    "Kamar": X_test_raw[:10, 1].astype(int),
    "Jarak (km)": X_test_raw[:10, 2],
    "Actual (Juta)": np.round(y_test[:10], 2),
    "Predicted (Juta)": np.round(y_pred[:10], 2),
    "Selisih Error (Juta)": np.round(np.abs(y_test[:10] - y_pred[:10]), 2)
})
print("=== TABEL PERBANDINGAN ACTUAL VS PREDICTED (10 DATA UJI PERTAMA) ===")
print(tabel_prediksi.to_string(index=False), "\n")

# ==============================================================================
# 5. VISUALISASI: ACTUAL VS PREDICTED & TRAINING LOSS
# ==============================================================================
jumlah_plot = 2 if len(train_losses) > 0 else 1
fig, axes = plt.subplots(1, jumlah_plot, figsize=(6.5 * jumlah_plot, 5))

ax1 = axes[0] if jumlah_plot == 2 else axes
ax1.scatter(y_test, y_pred, color="#1f77b4", edgecolors="black", alpha=0.8, s=60, label="Data Uji")

batas_min = min(y_test.min(), y_pred.min()) * 0.9
batas_max = max(y_test.max(), y_pred.max()) * 1.05
ax1.plot([batas_min, batas_max], [batas_min, batas_max], "--", color="#ff7f0e", linewidth=2, label="Prediksi Ideal (y = x)")

ax1.text(
    0.62, 0.12, f"R² = {r2:.4f}",
    transform=ax1.transAxes, fontsize=11, fontweight="bold",
    bbox=dict(boxstyle="round,pad=0.4", facecolor="#d9ead3", edgecolor="#6aa84f")
)
ax1.set_title("Actual vs Predicted", fontsize=12, fontweight="bold")
ax1.set_xlabel("Actual (juta)")
ax1.set_ylabel("Predicted (juta)")
ax1.legend(loc="upper left")
ax1.grid(True, linestyle="--", alpha=0.5)

if jumlah_plot == 2:
    ax2 = axes[1]
    ax2.plot(range(1, len(train_losses) + 1), train_losses, label="Train Loss", color="#1f77b4", linewidth=2)
    ax2.plot(range(1, len(val_losses) + 1), val_losses, label="Validation Loss", color="#ff7f0e", linewidth=2)
    ax2.set_title("Training Loss", fontsize=12, fontweight="bold")
    ax2.set_xlabel("Epoch")
    ax2.set_ylabel("Loss (MSE)")
    ax2.legend()
    ax2.grid(True, linestyle="--", alpha=0.5)

plt.tight_layout()
plt.show()

# ==============================================================================
# 6. ANALISIS DAN KESIMPULAN PERFORMA MODEL
# ==============================================================================
status_model = "SUDAH BAIK" if r2 >= 0.85 else "PERLU DITINGKATKAN"
print("=== ANALISIS & KESIMPULAN PERFORMA MODEL ===")
print(f"1. Status Performa : Model {status_model} dalam memprediksi harga rumah pada data uji.")
print(f"2. Akurasi (R²)    : Nilai R² sebesar {r2:.4f} menunjukkan bahwa {r2 * 100:.2f}% variasi harga rumah berhasil dijelaskan oleh fitur luas, jumlah kamar, dan jarak ke pusat kota.")
print(f"3. Tingkat Error   : Rata-rata selisih prediksi (MAE) sebesar Rp {mae:.2f} juta dengan RMSE sebesar Rp {rmse:.2f} juta, serta sebaran titik pada grafik Actual vs Predicted mengikuti garis diagonal y = x.")
if len(train_losses) > 0:
    print(f"4. Stabilitas Loss : Kurva Train Loss ({train_losses[-1]:.4f}) dan Validation Loss ({val_losses[-1]:.4f}) turun beriringan hingga konvergen tanpa indikasi overfitting.")
